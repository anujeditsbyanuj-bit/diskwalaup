# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file to git.

# ── Telegram (from my.telegram.org + @BotFather) ──────────────────
API_ID=
API_HASH=
BOT_TOKEN=

# Telethon StringSession — generate your OWN, see README "Getting SESSION"
# section. Do not reuse a session string from anywhere else; whoever holds
# it has full access to that Telegram account.
SESSION=

OWNER_ID=
TG_BOT_WORKERS=4
FORCE_SUB_CHANNEL=your_channel_username

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://user:password@yourcluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=diskwala_bot

# ── Premium plan pricing (optional — leave blank to disable) ───────
PLAN_1D_PRICE=₹10
PLAN_7D_PRICE=₹59
PLAN_30D_PRICE=₹149

# ── Payments (optional — only needed if you run the premium/QR flow)
PAYMENT_UPI=your-upi-id@bank
PAYMENT_MERCHANT_ID=your-merchant-id
ACTIVE_PAYMENT_ACCOUNT=default
PAYMENT_VERIFY_API=https://your-own-payment-verification-endpoint

# Chat ID that receives dump copies + premium activation notices
LOG_CHANNEL_ID=

# Set automatically by Render on Web Services; leave unset for
# Background Workers / local runs.
# PORT=10000
